# ─── Database ────────────────────────────────────────────────────────────────
# SQLite - relative to prisma/schema.prisma
DATABASE_URL="file:./ziggy.db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32
# If not set, a secret is auto-generated and stored in the DB (less secure).
JWT_SECRET=your-secret-here-generate-with-openssl-rand-hex-32

# Set to "true" to disable all auth checks (local development only)
# SKIP_AUTH=true

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Can also be set via the onboarding wizard (stored in DB).
# Env vars take precedence over DB values.
# Options: anthropic | perplexity | openai | ollama
AI_PROVIDER=anthropic

# Anthropic (Claude) — recommended
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Perplexity (good for web-augmented responses)
# PERPLEXITY_API_KEY=pplx-your-key-here

# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local models — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ─── Google Calendar (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/calendar/callback

# ─── Obsidian (optional) ──────────────────────────────────────────────────────
# OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# TUNNEL_TOKEN=your-cloudflare-tunnel-token

# ─── Worker / Scheduler (Phase 3) ────────────────────────────────────────────
# API token for the worker container to call the main app
# Generate via: Settings → API Tokens in the web UI
# SCHEDULER_API_TOKEN=your-worker-token-here

# ─── Telegram (Phase 3) ───────────────────────────────────────────────────────
# Can also be set via the onboarding wizard or Settings page (stored in DB).
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_CHAT_ID=your-personal-chat-id
# TELEGRAM_WEBHOOK_SECRET=auto-generated-on-webhook-setup
