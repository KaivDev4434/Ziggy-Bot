FROM node:22-alpine

WORKDIR /app

# Copy package files and install production deps only
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy source
COPY tsconfig.json ./
COPY src/worker ./src/worker
COPY src/lib/telegram ./src/lib/telegram

# Compile TypeScript
RUN npx tsc --project tsconfig.json --outDir dist --module commonjs --moduleResolution node \
    --noEmit false || true

# Run compiled worker
CMD ["node", "dist/src/worker/index.js"]
