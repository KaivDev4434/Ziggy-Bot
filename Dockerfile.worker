FROM node:22-alpine

WORKDIR /app

# Copy package files and install production deps only
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy source
COPY tsconfig.worker.json ./
COPY src/scheduler ./src/scheduler
COPY src/lib/telegram ./src/lib/telegram

# Compile TypeScript using the worker-specific tsconfig
RUN npx tsc --project tsconfig.worker.json

# Run compiled worker
CMD ["node", "dist/scheduler/index.js"]
