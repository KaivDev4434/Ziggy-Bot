FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
RUN npm install

# Install ts-node globally for development
RUN npm install -g ts-node nodemon

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Start development server with hot reload
CMD ["npm", "run", "dev"] 