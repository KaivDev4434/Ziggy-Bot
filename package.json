{
  "name": "@companion-chatbot/root",
  "version": "1.0.0",
  "private": true,
  "description": "Ziggy Bot - Advanced AI Companion Chatbot with NLP Task Management",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "start": "npm run start --workspace=backend",
    "build": "npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:watch": "npm run test:watch --workspace=backend",
    "test:coverage": "npm run test:coverage --workspace=backend",
    "test:ci": "npm run test:ci --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend",
    "lint": "npm run lint --workspace=backend",
    "lint:fix": "npm run lint:fix --workspace=backend",
    "clean": "rm -rf node_modules && npm run clean --workspace=backend",
    "setup": "npm install && npm run setup --workspace=backend",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:coverage"
  },
  "keywords": [
    "chatbot",
    "ai",
    "nlp",
    "task-management",
    "companion",
    "assistant",
    "natural-language-processing",
    "mongodb",
    "node.js",
    "typescript"
  ],
  "author": "Ziggy Bot Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaivDev4434/Ziggy-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/KaivDev4434/Ziggy-Bot/issues"
  },
  "homepage": "https://github.com/KaivDev4434/Ziggy-Bot#readme"
} 